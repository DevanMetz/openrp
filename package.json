{
  "name": "openrp",
  "version": "0.5.1",
  "private": true,
  "type": "module",
  "description": "An open-source, multiplayer DarkRP-inspired city sandbox built with Three.js.",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "tsx watch server/main.ts",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/main.ts --production",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "check": "npm run typecheck && npm test && npm run build && npm run test:production",
    "format": "prettier --write .",
    "test:production": "tsx scripts/smoke-production.ts",
    "analytics": "node --import tsx scripts/observe.ts analytics --url https://openrp.dev",
    "chatlogs": "node --import tsx scripts/observe.ts chat --url https://openrp.dev"
  },
  "dependencies": {
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "cannon-es": "^0.20.0",
    "three": "^0.180.0",
    "tsx": "^4.20.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/three": "^0.180.0",
    "@types/ws": "^8.18.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
