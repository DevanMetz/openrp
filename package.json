{
  "name": "openrp",
  "version": "0.6.5",
  "private": true,
  "type": "module",
  "description": "An open-source, multiplayer DarkRP-inspired city sandbox built with Three.js.",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node --import tsx scripts/dev.ts",
    "build": "vite build",
    "start": "wrangler dev",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.worker.json",
    "test": "node --import tsx --test tests/*.test.ts",
    "check": "npm run typecheck && npm test && node --import tsx scripts/smoke-production.ts && wrangler deploy --dry-run --outdir /tmp/openrp-dryrun",
    "format": "prettier --write .",
    "test:production": "npm run build && node --import tsx scripts/smoke-production.ts",
    "analytics": "node --import tsx scripts/observe.ts analytics --url https://openrp.dev",
    "chatlogs": "node --import tsx scripts/observe.ts chat --url https://openrp.dev",
    "deploy": "npm run build && wrangler deploy",
    "cf-typegen": "wrangler types --include-runtime false && prettier --write worker-configuration.d.ts",
    "pretest": "npm run build"
  },
  "dependencies": {
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "cannon-es": "^0.20.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261026.1",
    "@types/node": "^24.0.0",
    "@types/three": "^0.180.0",
    "@types/ws": "^8.18.0",
    "prettier": "^3.9.6",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "wrangler": "^4.152.0",
    "ws": "^8.18.0"
  }
}
