PORT=3000
HOST=0.0.0.0
SERVER_NAME=OpenRP | Union District
TRUST_PROXY=none
STARTING_MONEY=1500
SALARY_SECONDS=60
JAIL_SECONDS=60
DATA_DIR=./data
# Analytics and text chat retention, in UTC calendar days (1–90).
LOG_RETENTION_DAYS=30
# Optional read-only access key for /api/admin/analytics, /chat and /events.
# Generate a random secret; never commit it. Moderation still uses .admin-token.
# ANALYTICS_READ_TOKEN=
# Optional exact, comma-separated browser origins. Default: same host only.
# ALLOWED_ORIGINS=https://rp.example.com
# Optional password for joining this server.
# SERVER_PASSWORD=
